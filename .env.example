# =============================================================================
# Byggmedia — environment variables
# Real secrets live ONLY in the Hostinger panel. This file documents, never holds.
# The site BUILDS and RUNS with only the MINIMUM-TO-LAUNCH subset set below;
# everything else degrades gracefully.
# =============================================================================

# --- MINIMUM TO LAUNCH ---
NEXT_PUBLIC_SITE_URL=https://byggmedia.se
NEXT_PUBLIC_CONTACT_EMAIL=         # real inbox that is monitored
NEXT_PUBLIC_PHONE=+46725414099
NEXT_PUBLIC_ORG_NR=559184-4757
NEXT_PUBLIC_F_SKATT=true
NEXT_PUBLIC_REGION=Hela Sverige
NEXT_PUBLIC_RESPONSE_PROMISE=Svar inom 24 timmar

# Pricing (real). ⚠️ assumption: shown. Flip to false to hide everywhere.
NEXT_PUBLIC_VISA_PRIS=true
NEXT_PUBLIC_PRIS_FRAN=Från 1 995 kr/mån

# --- ADD LATER, ONE AT A TIME, REDEPLOY EACH ---
GHL_WEBHOOK_URL=                   # GHL inbound webhook (pending). Until set, GHL is skipped cleanly.
GHL_SANDBOX=true                   # keep true until a test contact is verified in GHL
SHEETS_WEBHOOK_URL=                # Google Sheets backup (set up week one). Until set, leads only in server logs.
NEXT_PUBLIC_GHL_CALENDAR_URL=      # GHL calendar iframe src (pending). Until set, /boka & /tack show phone/e-post fallback.
NEXT_PUBLIC_GHL_CHAT_ID=           # GHL chat widget id (pending). The bottom-bar Chatt icon calls window.openByggmediaChat.
